# Alchemy 生产环境变量示例
# 拷贝为 deploy/alchemy.env（该文件不纳入 git），再上传到服务器 /opt/alchemy/conf/alchemy.env
# systemd 通过 EnvironmentFile 加载；Python 筛股 CLI 继承 Java 进程环境

# 上传目录（对应 ruoyi.profile）
RUOYI_PROFILE=/opt/alchemy/upload

# Python 筛股 CLI（绝对路径；勿依赖 user.dir）
STOCK_PYTHON=/opt/alchemy/stock-screening-service/.venv/bin/python
STOCK_SCREENING_DIR=/opt/alchemy/stock-screening-service

# 与 Java 同一本机 MySQL
STOCK_DB_HOST=127.0.0.1
STOCK_DB_PORT=3306
STOCK_DB_USER=appuser
STOCK_DB_PASSWORD=<mysql-password>
STOCK_DB_NAME=appdb

# 覆盖 jar 内 yml，避免生产再绕公网 IP 连本机库/缓存
SPRING_DATASOURCE_DRUID_MASTER_URL=jdbc:mysql://127.0.0.1:3306/appdb?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia%2FShanghai
SPRING_DATASOURCE_DRUID_MASTER_USERNAME=appuser
SPRING_DATASOURCE_DRUID_MASTER_PASSWORD=<mysql-password>
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=<redis-password>

# JWT（生产必须覆盖 jar 内默认值）
TOKEN_SECRET=<jwt-secret>

# 邮件
SPRING_MAIL_USERNAME=<smtp-username>
SPRING_MAIL_PASSWORD=<smtp-password>
SPRING_MAIL_FROM=<from-address>

# Tushare
TUSHARE_TOKEN=<tushare-token>
